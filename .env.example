# ==============================================================================
# AudioBookshelf & Pipeline Configuration Template
# Copy this file to .env and fill in your credentials:
#   cp .env.example .env
# ==============================================================================

# AudioBookshelf server base URL
ABS_SERVER=http://localhost:3378

# Authentication: provide either ABS_TOKEN (recommended) or ABS_USERNAME + ABS_PASSWORD
ABS_TOKEN=
ABS_USERNAME=your_username
ABS_PASSWORD=your_password

# Target AudioBookshelf library name and automatic scan setting
ABS_LIBRARY=TTS
ABS_SCAN=true
