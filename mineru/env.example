# Copy to .env and edit for your hardware.

# ---- paths -------------------------------------------------------------
IN_DIR=./in
OUT_DIR=./out
GGUF_DIR=./models/gguf

# ---- CPU tuning --------------------------------------------------------
# PHYSICAL cores on a single NUMA socket (not hyperthreads)
MINERU_THREADS=10

# txt  = born-digital PDFs, use the embedded text layer (faster + better)
# auto = decide per page; needed if anything is scanned
# ocr  = force OCR everywhere
MINERU_METHOD=auto

# ---- MinerU ------------------------------------------------------------
# huggingface | modelscope | local
MINERU_MODEL_SOURCE=huggingface
# Pin for reproducible rebuilds, e.g. 3.4.5.
MINERU_VERSION=3.4.5

API_PORT=8000
API_CONCURRENCY=2

# ---- VLM profile (llama.cpp GGUF server) -------------------------------
# Compute capability of the target card (e.g. Tesla P100 = 60).
CUDA_ARCH=60
GPU_IDS=0
VLM_PORT=30000

# Exact filenames from the GGUF repo
GGUF_FILE=MinerU2.5-2509-1.2B-q8_0.gguf
MMPROJ_FILE=MinerU2.5-2509-1.2B-q8_0.mmproj
VLM_MODEL_NAME=MinerU2.5-2509-1.2B

# ---- client profile ----------------------------------------------------
# Inside the compose network use http://llamacpp:30000
VLM_URL=http://llamacpp:30000

MINERU_TASK_RESULT_TIMEOUT_SECONDS=43200
MINERU_API_MAX_CONCURRENT_REQUESTS=1
CUDA_VISIBLE_DEVICES=1
MINERU_VIRTUAL_VRAM_SIZE=12
